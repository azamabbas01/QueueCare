# Copy to .env and set values from the intended Supabase project. NEVER commit .env.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<server-only-secret-key>
AUTH_CONFIRMATION_URL=https://<api-host>/auth/confirm
CORS_ORIGINS=https://<approved-web-origin>
CLINIC_TIMEZONE=Asia/Karachi

# "production" hides /docs and removes the localhost CORS allowance.
ENVIRONMENT=production
DEFAULT_COUNTRY_CODE=92
# Long random string; used to hash national ID numbers so they are never stored in the clear.
NATIONAL_ID_PEPPER=<generate-with: python -c "import secrets;print(secrets.token_urlsafe(48))">

# Optional SMS fallback (Twilio). Leave empty to keep messages queued.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
